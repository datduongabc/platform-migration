DATABASE_URL=
SECRET_KEY=
KEY_ENCRYPTION_SECRET=
GEMINI_API_KEY=
SPEECHMATICS_API_KEY=

# Also used by docker-compose.yml's db service — keep in sync with the password
# embedded in DATABASE_URL above.
POSTGRES_PASSWORD=

# Comma-separated browser origins allowed by CORS. Leave unset for local dev
# (defaults to localhost); set to your real frontend domain(s) in production,
# e.g. https://app.example.com
ALLOWED_ORIGINS=

# Both must be set to seed an initial admin account on first startup (only runs
# when auth.users is empty). Leave both unset to skip seeding entirely.
SEED_DEFAULT_ADMIN_EMAIL=
SEED_DEFAULT_ADMIN_PASSWORD=
